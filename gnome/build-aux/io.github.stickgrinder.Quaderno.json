{
  "app-id": "io.github.stickgrinder.Quaderno",
  "runtime": "org.gnome.Platform",
  "runtime-version": "50",
  "sdk": "org.gnome.Sdk",
  "command": "quaderno",
  "sdk-extensions": [
    "org.freedesktop.Sdk.Extension.rust-stable"
  ],
  "finish-args": [
    "--share=ipc",
    "--socket=fallback-x11",
    "--socket=wayland",
    "--device=dri",
    "--talk-name=org.freedesktop.secrets",
    "--talk-name=org.gnome.ScreenSaver"
  ],
  "build-options": {
    "append-path": "/usr/lib/sdk/rust-stable/bin",
    "env": {
      "CARGO_HOME": "/run/build/quaderno/cargo"
    }
  },
  "modules": [
    {
      "name": "libspelling",
      "buildsystem": "meson",
      "builddir": true,
      "config-opts": [
        "-Ddocs=false",
        "-Dvapi=false"
      ],
      "sources": [
        {
          "type": "archive",
          "url": "https://gitlab.gnome.org/GNOME/libspelling/-/archive/0.4.10/libspelling-0.4.10.tar.gz",
          "sha256": "4a6f8b9f7dac6715e1bff1b28c5e58a56901968fa458e729e9e9b79452e85f04"
        }
      ]
    },
    {
      "name": "quaderno",
      "buildsystem": "simple",
      "build-commands": [
        "meson setup --prefix=/app --libdir=lib _build gnome",
        "meson compile -C _build",
        "meson install -C _build --no-rebuild"
      ],
      "test-commands": [
        "meson test -C _build"
      ],
      "sources": [
        "cargo-sources.json",
        {
          "type": "dir",
          "path": "../../",
          "skip": [
            ".git",
            ".flatpak-builder",
            "build",
            "build/*",
            "build-flatpak",
            "build-flatpak/*",
            "target",
            "target/*",
            "gnome/target",
            "gnome/target/*"
          ]
        }
      ]
    }
  ]
}
