<!-- The dark variant of the Quaderno scheme (see quaderno.xml). -->
<style-scheme id="quaderno-dark" name="Quaderno" version="1.0" parent-scheme="Adwaita-dark">
  <metadata>
    <description>Quaderno: marked-up Markdown (dark)</description>
  </metadata>

  <!-- Markdown punctuation stays quiet. -->
  <style name="def:list-marker" foreground="#77767b" bold="false"/>
  <style name="def:thematic-break" foreground="#77767b"/>
  <style name="def:shebang" foreground="#77767b" bold="false"/>
  <style name="def:link-destination" foreground="#77767b"/>
  <style name="def:link-symbol" foreground="#77767b"/>
  <style name="def:special-char" foreground="#77767b"/>

  <!-- Headings: same colour as the text, growing with the level. -->
  <style name="def:heading" foreground="#C0BFBC" bold="true"/>
  <style name="def:heading1" foreground="#C0BFBC" bold="true" scale="1.8"/>
  <style name="def:heading2" foreground="#C0BFBC" bold="true" scale="1.4"/>
  <style name="def:heading3" foreground="#C0BFBC" bold="true" scale="1.2"/>
  <style name="def:heading4" foreground="#C0BFBC" bold="true" scale="1.1"/>
  <style name="def:heading5" foreground="#C0BFBC" bold="true"/>
  <style name="def:heading6" foreground="#C0BFBC" bold="true"/>

  <!-- Inline and block formatting. -->
  <style name="def:strong-emphasis" bold="true"/>
  <style name="def:emphasis" italic="true"/>
  <style name="def:inline-code" foreground="#7D8AC7" background="#2A2A2E"/>
  <style name="def:preformatted-section" foreground="#7D8AC7" background="#26262A"/>
  <!-- Quotes are italic and slightly larger; the view draws their left bar. -->
  <style name="def:note" italic="true" scale="1.2"/>
</style-scheme>
