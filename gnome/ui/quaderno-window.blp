using Gtk 4.0;
using Adw 1;

template $QuadernoWindow: Adw.ApplicationWindow {
  default-width: 1180;
  default-height: 860;
  title: _("Quaderno");

  content: Adw.ToastOverlay toast_overlay {
    child: Gtk.Stack stack {
      transition-type: crossfade;

      Gtk.StackPage {
        name: "welcome";

        child: Gtk.ScrolledWindow {
          hscrollbar-policy: never;
          vscrollbar-policy: automatic;

          child: Adw.Clamp {
            maximum-size: 460;
            margin-top: 36;
            margin-bottom: 36;

            child: Gtk.Box {
              orientation: vertical;
              spacing: 24;

              Adw.StatusPage {
                icon-name: "io.github.stickgrinder.Quaderno";
                title: _("Create your journal");
                description: _("Everything you write is encrypted with this passphrase and stays on this device.");
              }

              Adw.PreferencesGroup {
                Adw.PasswordEntryRow passphrase_row {
                  title: _("Passphrase");
                }

                Adw.PasswordEntryRow repeat_row {
                  title: _("Repeat passphrase");
                }
              }

              Gtk.Box {
                orientation: vertical;
                spacing: 6;

                Gtk.LevelBar strength_bar {
                  max-value: 1.0;
                }

                Gtk.Label strength_label {
                  xalign: 0;
                  styles ["dim-label", "caption"]
                }
              }

              Adw.PreferencesGroup {
                Adw.ActionRow location_row {
                  title: _("Location");

                  [suffix]
                  Gtk.Button change_button {
                    label: _("Change…");
                    valign: center;
                  }
                }

                Adw.SwitchRow remember_row {
                  title: _("Remember passphrase on this device");
                  subtitle: _("Stored in GNOME Keyring");
                }
              }

              Adw.PreferencesGroup {
                Adw.ActionRow {
                  title: _("A forgotten passphrase cannot be recovered");
                  subtitle: _("There is no reset and no backdoor. If you lose it, the journal and its backups cannot be opened by anyone, including you.");

                  [prefix]
                  Gtk.CheckButton confirm_check {
                    valign: center;
                  }
                }
              }

              Gtk.Box {
                orientation: vertical;
                spacing: 6;

                Gtk.Button create_button {
                  label: _("Create Journal");
                  styles ["suggested-action", "pill"]
                }

                Gtk.Button open_button {
                  label: _("Open Existing Journal…");
                  styles ["flat", "pill"]
                }
              }
            };
          };
        };
      }

      Gtk.StackPage {
        name: "unlock";

        child: Adw.StatusPage unlock_page {
          icon-name: "system-lock-screen-symbolic";
          title: _("Quaderno is locked");

          child: Gtk.Box {
            orientation: vertical;
            spacing: 12;
            halign: center;
            valign: center;
            width-request: 360;

            Adw.PreferencesGroup {
              Adw.PasswordEntryRow unlock_entry {
                title: _("Passphrase");
                activates-default: true;
              }
            }

            Gtk.Label unlock_error {
              wrap: true;
              visible: false;
              styles ["error"]
            }

            Gtk.Button unlock_button {
              label: _("Unlock");
              styles ["suggested-action", "pill"]
            }
          };
        };
      }

      Gtk.StackPage {
        name: "error";

        child: Adw.StatusPage error_page {
          icon-name: "dialog-error-symbolic";
          title: _("Journal unavailable");

          child: Gtk.Box {
            orientation: vertical;
            spacing: 12;
            halign: center;
            valign: center;

            Gtk.Button locate_button {
              label: _("Locate file…");
              styles ["suggested-action", "pill"]
            }
          };
        };
      }

      Gtk.StackPage {
        name: "main";

        child: Adw.OverlaySplitView main_split {
          min-sidebar-width: 180;
          max-sidebar-width: 300;

          sidebar: Adw.ToolbarView {
            [top]
            Adw.HeaderBar {
              title-widget: Adw.WindowTitle {
                title: _("Quaderno");
              };

              [end]
              Gtk.MenuButton menu_button {
                icon-name: "open-menu-symbolic";
                tooltip-text: _("Main Menu");
              }
            }

            content: Gtk.ScrolledWindow {
              hscrollbar-policy: never;

              child: Gtk.ListBox sections_list {
                styles ["navigation-sidebar"]
                selection-mode: single;
              };
            };
          };

          content: Adw.NavigationSplitView {
            min-sidebar-width: 280;
            max-sidebar-width: 440;

            sidebar: Adw.NavigationPage {
              title: _("Timeline");

              child: Adw.ToolbarView {
              [top]
              Adw.HeaderBar {
                title-widget: Adw.WindowTitle {
                  title: _("Timeline");
                };

                [start]
                Gtk.ToggleButton sidebar_toggle {
                  icon-name: "sidebar-show-symbolic";
                  tooltip-text: _("Sections");
                  active: true;
                }

                [end]
                Gtk.ToggleButton search_button {
                  icon-name: "system-search-symbolic";
                  tooltip-text: _("Search");
                }

                [end]
                Gtk.Button new_button {
                  icon-name: "list-add-symbolic";
                  tooltip-text: _("New journal page");
                  styles ["suggested-action"]
                }
              }

              content: Gtk.Box {
                orientation: vertical;

                Gtk.SearchBar search_bar {
                  child: Gtk.SearchEntry search_entry {
                    placeholder-text: _("Search entries");
                  };
                }

                Adw.ToggleGroup filter_group {
                  margin-start: 6;
                  margin-end: 6;
                  margin-bottom: 6;

                  Adw.Toggle filter_all {
                    label: _("All");
                  }

                  Adw.Toggle filter_journal {
                    label: _("Journal");
                  }

                  Adw.Toggle filter_dreams {
                    label: _("Dreams");
                  }

                  Adw.Toggle filter_notes {
                    label: _("Notes");
                  }
                }

                Gtk.ScrolledWindow {
                  vexpand: true;
                  hscrollbar-policy: never;

                  child: Gtk.ListBox entry_list {
                    selection-mode: single;
                  };
                }
              };
            };
            };

            content: Adw.NavigationPage {
              child: Gtk.Stack editor_stack {
              Gtk.StackPage {
                name: "empty";

                child: Adw.StatusPage {
                  icon-name: "io.github.stickgrinder.Quaderno";
                  title: _("Your journal");
                  description: _("Select an entry or create a new one.");
                };
              }

              Gtk.StackPage {
                name: "entry";

                child: Adw.ToolbarView {
                  [top]
                  Adw.HeaderBar {
                    [start]
                    Gtk.Label type_badge {
                      label: _("Journal page");
                      styles ["dim-label", "caption"]
                    }

                    title-widget: Gtk.MenuButton date_button {
                      label: _("Date");

                      popover: Gtk.Popover {
                        child: Gtk.Box {
                          orientation: vertical;
                          spacing: 6;
                          margin-top: 6;
                          margin-bottom: 6;
                          margin-start: 6;
                          margin-end: 6;

                          Gtk.Calendar date_calendar {
                          }

                          Gtk.Box {
                            orientation: horizontal;
                            spacing: 6;

                            Gtk.Label {
                              label: _("Time");
                            }

                            Gtk.Entry time_entry {
                              placeholder-text: "HH:MM";
                              width-chars: 6;
                              hexpand: true;
                            }
                          }

                          Gtk.Box {
                            orientation: horizontal;
                            spacing: 6;
                            homogeneous: true;

                            Gtk.Button today_button {
                              label: _("Today");
                            }

                            Gtk.Button yesterday_button {
                              label: _("Yesterday");
                            }
                          }
                        };
                      };
                    };

                    [end]
                    Gtk.MenuButton entry_menu {
                      icon-name: "view-more-symbolic";
                      tooltip-text: _("Entry Menu");
                    }

                    [end]
                    Gtk.Label save_label {
                      styles ["dim-label", "caption"]
                    }
                  }

                  content: Gtk.Box {
                    orientation: vertical;

                    Adw.Banner main_banner {
                      revealed: false;
                    }

                    Adw.Banner backdated_banner {
                      revealed: false;
                    }

                    Gtk.ScrolledWindow editor_scroll {
                      vexpand: true;
                      hscrollbar-policy: never;
                    }

                    Gtk.Box {
                      orientation: horizontal;
                      spacing: 6;
                      margin-top: 6;
                      margin-bottom: 6;
                      margin-start: 12;
                      margin-end: 12;

                      Gtk.Button heading_button {
                        icon-name: "format-text-bold-symbolic";
                        tooltip-text: _("Heading");
                        styles ["flat"]
                      }

                      Gtk.Button bold_button {
                        icon-name: "format-text-bold-symbolic";
                        tooltip-text: _("Bold");
                        styles ["flat"]
                      }

                      Gtk.Button italic_button {
                        icon-name: "format-text-italic-symbolic";
                        tooltip-text: _("Italic");
                        styles ["flat"]
                      }

                      Gtk.Button list_button {
                        icon-name: "view-list-bullet-symbolic";
                        tooltip-text: _("List");
                        styles ["flat"]
                      }

                      Gtk.Button quote_button {
                        icon-name: "format-indent-more-symbolic";
                        tooltip-text: _("Quote");
                        styles ["flat"]
                      }

                      Gtk.Button link_button {
                        icon-name: "insert-link-symbolic";
                        tooltip-text: _("Link");
                        styles ["flat"]
                      }

                      Gtk.Label footer_label {
                        hexpand: true;
                        xalign: 1;
                        styles ["dim-label", "caption"]
                      }
                    }
                  };
                };
              }
            };
          };
        };
      };
    }
  };
};
}
