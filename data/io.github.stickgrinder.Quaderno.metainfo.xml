  <name>Quaderno</name>
  <summary>Private, encrypted journal</summary>
  <description>
    <p>
      Quaderno is a private journal for GNOME. Journal pages, dreams and quick
      notes are stored in a single encrypted file on your device.
    </p>
    <p>Everything stays local: no account, no server, no network access.</p>
    <p>
      Write about a day, record a dream with its mood on waking, or capture a
      quick note to expand later. Add optional metadata — ratings, emotions,
      activities, colours, people, places, things and tags — and browse it all
      on a timeline. Quaderno also makes automatic encrypted backups and can
      export your journal to Markdown or JSON.
    </p>
  </description>
  <launchable type="desktop-id">io.github.stickgrinder.Quaderno.desktop</launchable>
  <url type="homepage">https://github.com/stickgrinder/quaderno</url>
  <url type="bugtracker">https://github.com/stickgrinder/quaderno/issues</url>
  <url type="vcs-browser">https://github.com/stickgrinder/quaderno</url>
  <developer id="io.github.stickgrinder">
    <name>Paolo Pustorino</name>
  </developer>
  <content_rating type="oars-1.1"/>
